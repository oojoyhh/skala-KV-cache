# 이 파일을 복사해 .env를 만들고 값을 채운다 (.env는 커밋 금지)
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env

# 필수 — python app.py 시작 시 확인
OPENAI_API_KEY=
TAVILY_API_KEY=
# LangSmith 트레이스(과제 제출물) — smith.langchain.com에서 발급
LANGSMITH_API_KEY=

# 선택 — 비워 두면 config.py 기본값 사용
GENERATOR_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
USE_SEARCH_CACHE=0

# LangSmith 추적 설정 (계약 6장) — true여야 트레이스가 기록된다
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=skala-kv-cache-agent
